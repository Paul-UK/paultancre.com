---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, AUTHOR, GITHUB_REPO_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Social-card image, root-relative (e.g. "/charts/x-chart.png"). */
  image?: string;
  imageAlt?: string;
  /** "article" on experiment posts, "website" everywhere else. */
  type?: 'website' | 'article';
  /** Publication date, emitted as article:published_time on posts. */
  published?: Date;
}
const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  published,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
// Open Graph requires an absolute URL; a root-relative path is silently
// dropped by most scrapers.
const ogImage = image ? new URL(image, SITE_URL).href : undefined;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && (
      <meta property="article:published_time" content={published.toISOString()} />
    )}
    {/* Only claim a large-image card when there is actually an image to show;
        otherwise the post shares as an empty box. */}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap-wide">
        <a class="brand" href="/">{SITE_TITLE}</a>
        <nav>
          <a href="/">Experiments</a>
          <a href="/about/">About</a>
          <a href={GITHUB_REPO_URL} rel="me noopener" target="_blank">Code</a>
          <form class="nav-search" action="/" role="search">
            <input
              type="search"
              name="q"
              id="search"
              placeholder="Search experiments…"
              autocomplete="off"
              aria-label="Search experiments"
            />
          </form>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap-wide">
        <p class="disclaimer">
          The ideas and experiments here are mine, built with AI assistance.
          Every experiment documents its full method and numbers; published
          code is linked where it exists.
        </p>
        <p>© {year} {AUTHOR}</p>
      </div>
    </footer>

    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image" hidden>
      <button type="button" class="lightbox-close" aria-label="Close enlarged image">×</button>
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </div>
  </body>
</html>

<script>
  // Click-to-zoom lightbox for charts and body images. Preserves the image's
  // alt text: it drives the dialog label, the enlarged img's alt, and the
  // caption. Keyboard accessible (Enter/Space to open, Esc to close).
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('lightbox-cap');
  const lbClose = lb?.querySelector('.lightbox-close') as HTMLElement | null;
  let lastFocus: HTMLElement | null = null;

  // Mark charts and prose images (not nav/card thumbnails) as zoomable.
  const zoomables = document.querySelectorAll<HTMLImageElement>(
    'figure.chart img, .prose img'
  );
  for (const img of zoomables) {
    img.dataset.zoom = '';
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    const alt = img.getAttribute('alt') ?? '';
    img.setAttribute('aria-label', alt ? `Enlarge image: ${alt}` : 'Enlarge image');
  }

  function open(img: HTMLImageElement) {
    if (!lb || !lbImg) return;
    lastFocus = document.activeElement as HTMLElement | null;
    lbImg.src = img.currentSrc || img.src;
    const alt = img.getAttribute('alt') ?? '';
    lbImg.alt = alt;
    if (lbCap) lbCap.textContent = alt;
    lb.setAttribute('aria-label', alt || 'Enlarged image');
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose?.focus();
  }
  function close() {
    if (!lb || !lbImg) return;
    lb.hidden = true;
    lbImg.src = '';
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const zoom = t.closest?.('img[data-zoom]') as HTMLImageElement | null;
    if (zoom) { open(zoom); return; }
    // Any click inside the open lightbox (backdrop, image, close button) closes.
    if (lb && !lb.hidden && t.closest?.('#lightbox')) close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lb && !lb.hidden) { close(); return; }
    if (e.key === 'Enter' || e.key === ' ') {
      const el = document.activeElement as HTMLElement | null;
      if (el?.matches?.('img[data-zoom]')) {
        e.preventDefault();
        open(el as HTMLImageElement);
      }
    }
  });
</script>

<style>
  .nav-search { display: inline-block; margin-left: 1.1rem; }
  .nav-search input {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.32rem 0.85rem;
    width: 12rem;
    max-width: 42vw;
    transition: border-color 0.15s ease, width 0.15s ease;
  }
  .nav-search input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--bg);
  }
  @media (max-width: 560px) {
    .nav-search { display: block; margin: 0.6rem 0 0; width: 100%; }
    .nav-search input { width: 100%; max-width: none; }
  }
</style>
