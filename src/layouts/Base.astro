---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import {
  SITE_TITLE, SITE_DESCRIPTION, SITE_URL, AUTHOR, GITHUB_REPO_URL,
  OG_IMAGE, OG_IMAGE_ALT,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Social-card image, root-relative (e.g. "/charts/x-chart.png"). */
  image?: string;
  imageAlt?: string;
  /** "article" on experiment posts, "website" everywhere else. */
  type?: 'website' | 'article';
  /** Publication date, emitted as article:published_time on posts. */
  published?: Date;
}
const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  published,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
// Open Graph requires an absolute URL; a root-relative path is silently
// dropped by most scrapers. Pages without a chart of their own fall back to the
// site card, so every link previews as a large image rather than bare text.
const ogImage = new URL(image ?? OG_IMAGE, SITE_URL).href;
const ogImageAlt = image ? imageAlt : OG_IMAGE_ALT;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {published && (
      <meta property="article:published_time" content={published.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* The two faces that paint the first screen on every page. The rest of the
        subsets are pulled in by unicode-range only when a page needs them. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/newsreader-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/inter-latin.woff2" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} experiments`}
      href={new URL('/rss.xml', SITE_URL).href}
    />
    <ClientRouter />

    {/* Runs before first paint so the stored theme never flashes, and again
        after every client-side navigation, because ClientRouter restores
        <html>'s authored attributes on swap. */}
    <script is:inline>
      (function () {
        function applyChrome() {
          var d = document.documentElement;
          d.classList.remove('no-js');
          var t = null;
          try { t = localStorage.getItem('theme'); } catch (e) {}
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
          else d.removeAttribute('data-theme');
          var btn = document.querySelector('.theme-toggle');
          if (btn) {
            var state = d.getAttribute('data-theme') || 'system';
            var next = state === 'system' ? 'light' : state === 'light' ? 'dark' : 'system';
            btn.setAttribute('aria-label', 'Theme: ' + state + '. Switch to ' + next + '.');
            btn.setAttribute('title', 'Theme: ' + state);
          }
        }
        applyChrome();

        // The reveal animations start at opacity 0 and are only ever made
        // visible by the bundled module script below. applyChrome() has just
        // dropped the .no-js escape hatch, so if that module fails to load or
        // throws, every card, track heading and the signature would stay
        // invisible for good. If it has not announced itself in time, put the
        // hatch back and show everything unanimated.
        setTimeout(function () {
          var d = document.documentElement;
          if (!d.classList.contains('js-ready')) d.classList.add('no-js');
        }, 2500);

        // Cycles system -> light -> dark -> system. Delegated once, so it keeps
        // working after the header is swapped out by a navigation.
        document.addEventListener('click', function (e) {
          var btn = e.target.closest && e.target.closest('.theme-toggle');
          if (!btn) return;
          var d = document.documentElement;
          var cur = d.getAttribute('data-theme');
          var next = cur === null ? 'light' : cur === 'light' ? 'dark' : null;
          try {
            if (next) localStorage.setItem('theme', next);
            else localStorage.removeItem('theme');
          } catch (err) {}
          if (next) d.setAttribute('data-theme', next);
          else d.removeAttribute('data-theme');
          applyChrome();
        });
        document.addEventListener('astro:after-swap', applyChrome);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" transition:persist="site-header">
      <div class="wrap-wide">
        <a class="brand" href="/">{SITE_TITLE}</a>
        <nav>
          <a class="u" href="/">Experiments</a>
          <a class="u" href="/about/">About</a>
          <a class="u" href={GITHUB_REPO_URL} rel="me noopener" target="_blank">Code</a>
          <form class="nav-search" action="/" role="search">
            <input
              type="search"
              name="q"
              id="search"
              placeholder="Search experiments…"
              autocomplete="off"
              aria-label="Search experiments"
            />
          </form>
          <button type="button" class="theme-toggle" aria-label="Switch theme">
            <svg class="i-system" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="13" rx="2" /><path d="M8 21h8M12 17v4" />
            </svg>
            <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" />
            </svg>
            <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap-wide">
        <p class="disclaimer">
          The ideas and experiments here are mine, built with AI assistance.
          Every experiment documents its full method and numbers; published
          code is linked where it exists.
        </p>
        <p>
          © {year} {AUTHOR} · <a class="u" href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>

    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image" hidden>
      <button type="button" class="lightbox-close" aria-label="Close enlarged image">×</button>
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </div>
  </body>
</html>

<script>
  // Click-to-zoom lightbox for charts and body images, plus the scroll-reveal
  // observer. Both are re-armed on every astro:page-load (which also fires on
  // the first load) because ClientRouter swaps the body without re-running
  // module scripts; the document-level listeners are registered only once.
  const lb = () => document.getElementById('lightbox');
  const lbImg = () => document.getElementById('lightbox-img') as HTMLImageElement | null;
  let lastFocus: HTMLElement | null = null;

  function open(img: HTMLImageElement) {
    const box = lb(), boxImg = lbImg();
    if (!box || !boxImg) return;
    lastFocus = document.activeElement as HTMLElement | null;
    boxImg.src = img.currentSrc || img.src;
    const alt = img.getAttribute('alt') ?? '';
    boxImg.alt = alt;
    const cap = document.getElementById('lightbox-cap');
    if (cap) cap.textContent = alt;
    box.setAttribute('aria-label', alt || 'Enlarged image');
    box.hidden = false;
    document.body.style.overflow = 'hidden';
    box.querySelector<HTMLElement>('.lightbox-close')?.focus();
  }
  function close() {
    const box = lb(), boxImg = lbImg();
    if (!box || !boxImg) return;
    box.hidden = true;
    boxImg.src = '';
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const zoom = t.closest?.('img[data-zoom]') as HTMLImageElement | null;
    if (zoom) { open(zoom); return; }
    // Any click inside the open lightbox (backdrop, image, close button) closes.
    const box = lb();
    if (box && !box.hidden && t.closest?.('#lightbox')) close();
  });

  document.addEventListener('keydown', (e) => {
    const box = lb();
    if (e.key === 'Escape' && box && !box.hidden) { close(); return; }
    if (e.key === 'Enter' || e.key === ' ') {
      const el = document.activeElement as HTMLElement | null;
      if (el?.matches?.('img[data-zoom]')) {
        e.preventDefault();
        open(el as HTMLImageElement);
      }
    }
  });

  // One observer for the whole session; elements are handed to it per page.
  const io = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        if (en.isIntersecting) {
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      }
    },
    { rootMargin: '0px 0px -10% 0px' }
  );

  function arm() {
    // Tells the head script the reveal machinery is alive (see its timeout).
    document.documentElement.classList.add('js-ready');
    // Mark charts and prose images (not nav/card thumbnails) as zoomable.
    const zoomables = document.querySelectorAll<HTMLImageElement>(
      'figure.chart img, .prose img'
    );
    for (const img of zoomables) {
      if (img.dataset.zoom !== undefined) continue;
      img.dataset.zoom = '';
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      const alt = img.getAttribute('alt') ?? '';
      img.setAttribute('aria-label', alt ? `Enlarge image: ${alt}` : 'Enlarge image');
    }
    for (const el of document.querySelectorAll('.reveal:not(.in)')) io.observe(el);
  }

  // astro:page-load also fires on the first load, but arm() is idempotent and
  // a .reveal that is never observed would stay at opacity 0 forever, so it is
  // also called directly.
  arm();
  document.addEventListener('astro:page-load', arm);
</script>

<style>
  /* Off-screen until focused, then pinned to the top-left. */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 1100;
    background: var(--bg);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0 0 6px 0;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .skip-link:focus {
    left: 0;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .nav-search { display: inline-block; }
  .nav-search input {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.32rem 0.85rem;
    width: 12rem;
    max-width: 42vw;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .nav-search input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--bg);
  }
  @media (max-width: 620px) {
    .site-header nav { flex-wrap: wrap; gap: 0.9rem 1.1rem; }
    .nav-search { order: 1; flex: 1 1 100%; }
    .nav-search input { width: 100%; max-width: none; }
  }
</style>
