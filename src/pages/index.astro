---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StudyCard from '../components/StudyCard.astro';
import { SITE_TITLE, SITE_TAGLINE, TRACKS } from '../consts';
import { isPublished } from '../lib/collections';

const all = (await getCollection('experiments'))
  .filter(isPublished)
  .sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date);

const trackKeys = Object.keys(TRACKS) as (keyof typeof TRACKS)[];
const byTrack = trackKeys.map((key) => ({
  key,
  ...TRACKS[key],
  studies: all.filter((s) => s.data.track === key),
}));
---

<Base>
  <section class="hero wrap-wide">
    <p class="eyebrow fade">Research notes</p>
    <h1><span class="line"><span style="--d:0.06s">{SITE_TITLE}</span></span></h1>
    <p class="tagline lede fade" style="--d:0.2s">{SITE_TAGLINE}</p>
    <p class="intro fade" style="--d:0.34s">
      Each post is a small, self-contained experiment with a real result: the
      chart, the method, and the numbers behind it. Two threads run through
      the lab, and they read differently on purpose. <strong>Local-model
      probes</strong> are quick, fully programmatic experiments on open-weight
      models running on a laptop. <strong>Alignment audits</strong> are slower,
      multi-turn adversarial studies of safety behavior, scored by a frontier
      judge.
    </p>
  </section>

  <div class="wrap-wide">
    <p id="noresults" class="noresults mono" hidden>No experiments match that search.</p>
  </div>

  {byTrack.map((track) => (
    <section class="track wrap-wide" data-track-section>
      <div class="track-head reveal">
        <h2>{track.label}</h2>
        <p>{track.blurb}</p>
      </div>
      <div class="grid">
        {track.studies.map((study, i) => <StudyCard study={study} index={i} />)}
      </div>
    </section>
  ))}
</Base>

<script>
  // The search input lives in the nav (see Base.astro). On the homepage we
  // filter cards live; on other pages the nav form submits to /?q= and this
  // page reads it on load.
  //
  // The header is transition:persist'd, so the input survives navigation while
  // the cards do not. Everything is therefore delegated at the document level
  // once, and `apply` is re-pointed at the current page's cards on each
  // astro:page-load.
  let apply: (query: string) => void = () => {};
  let onHome = false;

  function init() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-track-section]')
    );
    const noresults = document.getElementById('noresults');
    const input = document.getElementById('search') as HTMLInputElement | null;
    onHome = cards.length > 0;
    if (!onHome) { apply = () => {}; return; }

    apply = (query: string) => {
      const q = query.trim().toLowerCase();
      let anyVisible = false;
      for (const card of cards) {
        const hay = card.dataset.haystack ?? '';
        const match = q === '' || hay.includes(q);
        card.hidden = !match;
        if (match) anyVisible = true;
      }
      // Hide a track section if none of its cards are visible.
      for (const section of sections) {
        const visible = section.querySelectorAll('.card:not([hidden])').length;
        section.hidden = visible === 0;
      }
      if (noresults) noresults.hidden = anyVisible;
    };

    // Prefill from ?q= (e.g. a tag link from a post page), or from whatever the
    // persisted input already holds after a client-side navigation home.
    const q0 = new URLSearchParams(location.search).get('q') ?? input?.value ?? '';
    if (q0) {
      if (input) input.value = q0;
      apply(q0);
    }
  }

  document.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t?.id === 'search') apply((t as HTMLInputElement).value);
  });

  // On the homepage, Enter shouldn't reload the page (results are already live).
  document.addEventListener('submit', (e) => {
    if (onHome && (e.target as HTMLElement)?.closest?.('.nav-search')) e.preventDefault();
  });

  // Clickable tags -> fill the search box.
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.chip[data-tag]');
    if (!el || !onHome) return;
    const input = document.getElementById('search') as HTMLInputElement | null;
    if (!input) return;
    input.value = el.dataset.tag ?? '';
    apply(input.value);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .hero { margin-bottom: 3.5rem; }
  .hero h1 { font-size: var(--h1); margin: 0.4rem 0 0.7rem; }
  .tagline { margin: 0 0 1.2rem; max-width: 40rem; }
  .intro { color: var(--ink-2); max-width: 42rem; }

  .noresults { margin: 0 0 1.5rem; color: var(--ink-3); }

  .track { margin-bottom: 4rem; }
  .track-head {
    border-top: 1px solid var(--border);
    padding-top: 1.4rem;
    margin-bottom: 1.6rem;
    display: flex;
    gap: 2rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .track-head h2 { margin: 0; font-size: 1.65rem; flex: 0 0 auto; }
  .track-head p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
    flex: 1 1 22rem;
    max-width: 34rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.4rem;
  }
</style>
