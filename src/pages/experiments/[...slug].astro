---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TRACKS } from '../../consts';
import { readingMinutes } from '../../lib/readingTime';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

interface Props {
  study: CollectionEntry<'experiments'>;
}
const { study } = Astro.props;
const { title, finding, track, date, chart, chartAlt, tools } = study.data;
const { Content } = await render(study);
const minutes = readingMinutes(study.body ?? '');
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base title={title} description={finding}>
  <div class="progress" aria-hidden="true"><div class="progress-fill"></div></div>

  <article class="wrap">
    <p class="eyebrow"><a href="/">{TRACKS[track].label}</a></p>
    <h1>{title}</h1>
    <p class="finding">{finding}</p>

    <div class="meta mono">
      <span>{dateStr}</span>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </div>
    {tools.length > 0 && (
      <div class="chips">
        {tools.map((t) => (
          <a class="chip" href={`/?q=${encodeURIComponent(t)}`}>{t}</a>
        ))}
      </div>
    )}

    {chart && (
      <figure class="chart">
        <img src={`/charts/${chart}`} alt={chartAlt ?? title} />
        {chartAlt && <figcaption>{chartAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <p class="back mono"><a href="/">← all experiments</a></p>
  </article>
</Base>

<script>
  // Reading-progress bar. Tracks position through the article, so it reads
  // 100% when the last line of the post is on screen, not when the footer is.
  // Transform rather than width keeps it off the layout path; the
  // ResizeObserver catches the chart image landing and changing the height.
  const fill = document.querySelector<HTMLElement>('.progress-fill');
  const article = document.querySelector<HTMLElement>('article.wrap');

  if (fill && article) {
    let queued = false;

    function update() {
      queued = false;
      const end = article.offsetTop + article.offsetHeight - window.innerHeight;
      // Article fits on one screen: there is no progress to show.
      const pct = end <= 0 ? 0 : Math.min(1, Math.max(0, window.scrollY / end));
      fill.style.transform = `scaleX(${pct})`;
    }

    function schedule() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    new ResizeObserver(schedule).observe(article);
    update();
  }
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    /* Under the lightbox (1000) so an enlarged chart covers it. */
    z-index: 900;
    pointer-events: none;
  }
  .progress-fill {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  h1 { font-size: 2rem; margin: 0.3rem 0 0.6rem; }
  .finding {
    font-size: 1.2rem;
    color: var(--ink);
    margin: 0 0 1.2rem;
    line-height: 1.45;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .chips a.chip { text-decoration: none; }
  .chips a.chip:hover { border-color: var(--accent); color: var(--accent); }
  .back { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
</style>
