---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TRACKS } from '../../consts';
import { readingMinutes } from '../../lib/readingTime';
import { isPublished } from '../../lib/collections';

export async function getStaticPaths() {
  const experiments = (await getCollection('experiments')).filter(isPublished);
  return experiments.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

interface Props {
  study: CollectionEntry<'experiments'>;
}
const { study } = Astro.props;
const { title, finding, track, date, chart, chartAlt, tools } = study.data;
const { Content } = await render(study);
const minutes = readingMinutes(study.body ?? '');
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base
  title={title}
  description={finding}
  image={chart ? `/charts/${chart}` : undefined}
  imageAlt={chartAlt}
  type="article"
  published={date}
>
  <div class="progress" aria-hidden="true"><div class="progress-fill"></div></div>

  <article class="wrap">
    <p class="eyebrow"><a href="/">{TRACKS[track].label}</a></p>
    {/* Same name as the card's h3 on the homepage, so the title carries across
        the navigation rather than fading out and back in. */}
    <h1 transition:name={`study-title-${study.id}`}>{title}</h1>
    <p class="finding lede">{finding}</p>

    <div class="meta mono">
      <time datetime={date.toISOString().slice(0, 10)}>{dateStr}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </div>
    {tools.length > 0 && (
      <div class="chips">
        {tools.map((t) => (
          <a class="chip" href={`/?q=${encodeURIComponent(t)}`}>{t}</a>
        ))}
      </div>
    )}

    {chart && (
      <figure class="chart">
        <img src={`/charts/${chart}`} alt={chartAlt ?? title} />
        {chartAlt && <figcaption>{chartAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <p class="back mono"><a class="u" href="/">← all experiments</a></p>
  </article>
</Base>

<script>
  // Reading-progress bar. Tracks position through the article, so it reads
  // 100% when the last line of the post is on screen, not when the footer is.
  // Transform rather than width keeps it off the layout path; the
  // ResizeObserver catches the chart image landing and changing the height.
  //
  // Listeners are registered once and the elements re-queried per frame, so the
  // bar keeps working across client-side navigations (and does nothing on the
  // pages that have no article).
  let queued = false;

  function update() {
    queued = false;
    const fill = document.querySelector<HTMLElement>('.progress-fill');
    const article = document.querySelector<HTMLElement>('article.wrap');
    if (!fill || !article) return;
    const end = article.offsetTop + article.offsetHeight - window.innerHeight;
    // Article fits on one screen: there is no progress to show.
    const pct = end <= 0 ? 0 : Math.min(1, Math.max(0, window.scrollY / end));
    fill.style.transform = `scaleX(${pct})`;
  }

  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  }

  const ro = new ResizeObserver(schedule);
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);

  function attach() {
    ro.disconnect();
    const article = document.querySelector<HTMLElement>('article.wrap');
    if (article) ro.observe(article);
    update();
  }

  attach();
  document.addEventListener('astro:page-load', attach);
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    /* Under the lightbox (1000) so an enlarged chart covers it. */
    z-index: 900;
    pointer-events: none;
  }
  .progress-fill {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  h1 { font-size: clamp(1.9rem, 1.3rem + 2.2vw, 2.7rem); margin: 0.4rem 0 0.7rem; }
  .finding { margin: 0 0 1.3rem; }
  .meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .chips a.chip { text-decoration: none; }
  .chips a.chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .back { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .back a { color: var(--ink-2); }
  .back a:hover { color: var(--accent); }
</style>
