---
import type { CollectionEntry } from 'astro:content';
import { TRACKS } from '../consts';
import { readingMinutes } from '../lib/readingTime';

interface Props {
  study: CollectionEntry<'experiments'>;
  /** Position within its track, used to stagger the scroll-in. */
  index?: number;
}
const { study, index = 0 } = Astro.props;
const { title, finding, chart, date, tools, track, startHere } = study.data;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const minutes = readingMinutes(study.body ?? '');

// Plain-text search haystack: title, finding, tags, track label, and body.
const haystack = [
  title,
  finding,
  tools.join(' '),
  TRACKS[track].label,
  study.body ?? '',
].join(' • ').toLowerCase();
---

<article
  class:list={['card', 'reveal', { 'is-start': startHere }]}
  style={`--d:${(index * 0.07).toFixed(2)}s`}
  data-haystack={haystack}
>
  {startHere && <span class="start-badge" aria-hidden="true">Start here</span>}
  <a class="card-link" href={`/experiments/${study.id}/`}>
    {chart && (
      <div class="thumb">
        <img src={`/charts/${chart}`} alt="" loading="lazy" />
      </div>
    )}
    <div class="body">
      {/* Pairs with the h1 on the post page: the title morphs across the
          navigation instead of cross-fading with everything else. */}
      <h3 transition:name={`study-title-${study.id}`}>{title}</h3>
      <p class="finding">{finding}</p>
    </div>
  </a>
  <div class="foot">
    <div class="chips">
      {tools.slice(0, 4).map((t) => (
        <button type="button" class="chip" data-tag={t}>{t}</button>
      ))}
    </div>
    <span class="date mono">
      <time datetime={date.toISOString().slice(0, 10)}>{dateStr}</time> · {minutes} min
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
  }
  /* The reveal owns opacity/transform, so hover only touches border and shadow
     — otherwise the two transitions fight over the same properties. */
  .card:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.45);
  }
  .card.is-start { border-color: var(--accent); }
  .start-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    background: var(--accent);
    color: var(--bg);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    pointer-events: none;
  }
  .card-link { text-decoration: none; color: inherit; }
  .card-link:hover { text-decoration: none; }
  .thumb {
    background: #fff;
    border-bottom: 1px solid var(--border);
    aspect-ratio: 16 / 8;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.5s var(--ease);
  }
  .card:hover .thumb img { transform: scale(1.035); }
  .body { padding: 1rem 1.1rem 0.5rem; }
  .body h3 {
    margin: 0 0 0.4rem;
    font-size: 1.16rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .card:hover .body h3 { color: var(--accent); }
  .finding { margin: 0; color: var(--ink-2); font-size: 0.9rem; line-height: 1.5; }
  .foot {
    margin-top: auto;
    padding: 0.7rem 1.1rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .foot .chips { margin: 0; }
  .chip { cursor: pointer; font-size: 0.68rem; padding: 0.1rem 0.5rem; }
  .chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .date { font-size: 0.7rem; color: var(--ink-3); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .thumb img, .body h3 { transition: none; }
    .card:hover .thumb img { transform: none; }
  }
</style>
