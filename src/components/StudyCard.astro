---
import type { CollectionEntry } from 'astro:content';
import { TRACKS } from '../consts';

interface Props {
  study: CollectionEntry<'experiments'>;
}
const { study } = Astro.props;
const { title, finding, chart, date, tools, track } = study.data;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

// Plain-text search haystack: title, finding, tags, track label, and body.
const haystack = [
  title,
  finding,
  tools.join(' '),
  TRACKS[track].label,
  study.body ?? '',
].join(' • ').toLowerCase();
---

<article class="card" data-haystack={haystack}>
  <a class="card-link" href={`/experiments/${study.id}/`}>
    {chart && (
      <div class="thumb">
        <img src={`/charts/${chart}`} alt="" loading="lazy" />
      </div>
    )}
    <div class="body">
      <h3>{title}</h3>
      <p class="finding">{finding}</p>
    </div>
  </a>
  <div class="foot">
    <div class="chips">
      {tools.slice(0, 4).map((t) => (
        <button type="button" class="chip" data-tag={t}>{t}</button>
      ))}
    </div>
    <span class="date mono">{dateStr}</span>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card-link { text-decoration: none; color: inherit; }
  .card-link:hover { text-decoration: none; }
  .thumb {
    background: #fff;
    border-bottom: 1px solid var(--border);
    aspect-ratio: 16 / 8;
    overflow: hidden;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .body { padding: 0.9rem 1rem 0.4rem; }
  .body h3 { margin: 0 0 0.35rem; font-size: 1.02rem; }
  .finding { margin: 0; color: var(--ink-2); font-size: 0.9rem; line-height: 1.5; }
  .foot {
    margin-top: auto;
    padding: 0.6rem 1rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .foot .chips { margin: 0; }
  .chip {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-2);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .date { font-size: 0.72rem; color: var(--ink-3); white-space: nowrap; }
</style>
